apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: rollout-ingress-version
  annotations:
    kubernetes.io/ingress.class: nginx
spec:
  ingressClassName: nginx
  rules:
  - host: dashboard.kantanm.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: argo-rollouts-dashboard 
            port:
              number: 3100

